#!/usr/bin/env bash
set -euo pipefail
binary="${GODOT_BIN:-/Applications/Godot.app/Contents/MacOS/Godot}"
if [[ ! -x "$binary" ]]; then
  binary="$(command -v godot || command -v godot4 || true)"
fi
[[ -n "$binary" ]] || { echo 'Godot not found. Set GODOT_BIN to the executable.' >&2; exit 1; }
exec "$binary" "$@"
